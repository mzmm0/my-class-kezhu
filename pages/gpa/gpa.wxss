.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 160rpx;
}

.stats-card {
  margin: 24rpx;
  background: #2f6fed;
  border-radius: 20rpx;
  color: #fff;
  padding: 36rpx 32rpx 28rpx;
}
.st-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}
.st-num {
  font-size: 84rpx;
  font-weight: 700;
  line-height: 1.1;
}
.st-label {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}
.st-row {
  display: flex;
}
.st-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.st-v {
  font-size: 34rpx;
  font-weight: 600;
}
.st-k {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

.term {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.term-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid #f0f2f5;
}
.t-name {
  font-size: 30rpx;
  font-weight: 700;
}
.t-gpa {
  font-size: 24rpx;
  color: #2f6fed;
}
.g-row {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #f7f8fa;
}
.g-row:last-child {
  border-bottom: none;
}
.g-name {
  flex: 1;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.g-credit {
  width: 110rpx;
  font-size: 24rpx;
  color: #8a8f99;
  text-align: right;
}
.g-score {
  width: 100rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: right;
}
.g-gp {
  width: 90rpx;
  font-size: 24rpx;
  color: #3fbf7f;
  text-align: right;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #2f6fed;
  color: #fff;
  font-size: 56rpx;
  line-height: 92rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(47, 111, 237, 0.4);
  z-index: 50;
}

.share-hint {
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
