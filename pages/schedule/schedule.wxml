<view class="page">
  <view class="toolbar">
    <view class="week-nav">
      <view class="wn-btn" bindtap="prevWeek">‹</view>
      <view class="wn-label" bindtap="backNow">第 {{week}} 周</view>
      <view class="wn-btn" bindtap="nextWeek">›</view>
    </view>
    <view class="tb-actions">
      <view class="tb-btn" bindtap="exportImage">导出图</view>
      <view class="tb-btn" bindtap="showImport">导入</view>
      <view class="tb-btn" bindtap="doShare">分享</view>
      <view class="tb-btn" bindtap="saveAllCourses">全部保存</view>
    </view>
  </view>

  <!-- 课前提醒续订条：开启提醒的用户每天可见，点一下续订当日额度 -->
  <view class="remind-bar {{remindBar.done ? 'rb-done' : 'rb-todo'}}" wx:if="{{remindBar.show}}" bindtap="remindBarTap">
    <view class="rb-text">{{remindBar.text}}</view>
    <view class="rb-arrow" wx:if="{{!remindBar.done}}">续订 ›</view>
  </view>

  <view class="today-card {{todayBar.mode}}" wx:if="{{todayBar}}">
    <view class="td-dot"></view>
    <view class="td-main">
      <view class="td-title">{{todayBar.title}}</view>
      <view class="td-sub">{{todayBar.sub}}</view>
    </view>
  </view>

  <view class="grid-head">
    <view class="gh-corner"></view>
    <view
      class="gh-day {{todayIdx === index + 1 ? 'gh-today' : ''}}"
      wx:for="{{days}}"
      wx:key="*this"
      wx:for-index="index"
    >
      <text>{{item}}</text>
    </view>
  </view>

  <scroll-view class="grid-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="grid-body" style="height: {{gridHeight}}rpx;">
      <view
        class="time-cell {{item.major ? 'time-major' : ''}} {{item.last ? 'time-last' : ''}}"
        wx:for="{{timeCol}}"
        wx:key="key"
        style="top: {{index * 112}}rpx;"
      >
        <text class="tc-no">{{item.no}}</text>
        <text class="tc-time">{{item.time}}</text>
      </view>
      <view
        class="cell {{item.major ? 'cell-major' : ''}} {{item.last ? 'cell-last' : ''}}"
        wx:for="{{cells}}"
        wx:key="key"
        style="left: {{item.left}}rpx; top: {{item.top}}rpx;"
        data-day="{{item.day}}"
        data-period="{{item.period}}"
        bindtap="onCellTap"
      ></view>
      <view
        class="course-block {{item.dim ? 'cb-dim' : ''}}"
        wx:for="{{blocks}}"
        wx:key="id"
        style="{{item.style}}"
        data-id="{{item.id}}"
        bindtap="onBlockTap"
      >
        <view class="cb-name">{{item.name}}</view>
        <view class="cb-sub" wx:if="{{!item.dim && item.room}}">@{{item.room}}</view>
        <view class="cb-sub" wx:if="{{!item.dim && item.teacher}}">{{item.teacher}}</view>
        <view class="cb-tag" wx:if="{{item.dim}}">{{item.tag}}</view>
      </view>
    </view>
  </scroll-view>

  <view class="empty-tip" wx:if="{{!hasCourse}}">点击任意格子，添加你的第一节课</view>

  <!-- 课程编辑弹窗 -->
  <view class="mask" wx:if="{{editor}}" bindtap="closeEditor">
    <view class="panel" catchtap="noop">
      <view class="p-title">{{editForm.id ? '编辑课程' : '添加课程'}}</view>
      <view class="f-row">
        <text class="f-label">课程名</text>
        <input class="f-input" value="{{editForm.name}}" data-k="name" bindinput="onField" placeholder="如：高等数学" />
      </view>
      <view class="f-row">
        <text class="f-label">老师</text>
        <input class="f-input" value="{{editForm.teacher}}" data-k="teacher" bindinput="onField" placeholder="选填" />
      </view>
      <view class="f-row">
        <text class="f-label">教室</text>
        <input class="f-input" value="{{editForm.room}}" data-k="room" bindinput="onField" placeholder="选填" />
      </view>
      <view class="f-row3">
        <picker class="f-pick" mode="selector" range="{{dayOptions}}" value="{{editForm.dayIdx}}" data-k="dayIdx" bindchange="onField">
          <view class="pick-val">{{dayOptions[editForm.dayIdx]}}</view>
        </picker>
        <picker class="f-pick" mode="selector" range="{{startOptions}}" value="{{editForm.startIdx}}" data-k="startIdx" bindchange="onField">
          <view class="pick-val">第 {{editForm.startIdx + 1}} 节起</view>
        </picker>
        <picker class="f-pick" mode="selector" range="{{lenOptions}}" value="{{editForm.lenIdx}}" data-k="lenIdx" bindchange="onField">
          <view class="pick-val">上 {{editForm.lenIdx + 1}} 节</view>
        </picker>
      </view>
      <view class="f-row">
        <text class="f-label">周次范围</text>
        <picker class="f-input2" mode="selector" range="{{rangeModes}}" value="{{editForm.rangeIdx}}" data-k="rangeIdx" bindchange="onField">
          <view class="pick-val">{{rangeModes[editForm.rangeIdx]}}</view>
        </picker>
      </view>
      <view class="f-row" wx:if="{{editForm.rangeIdx === 1}}">
        <text class="f-label">区间</text>
        <view class="f-row3" style="flex: 1;">
          <picker class="f-pick" mode="selector" range="{{weekRange}}" value="{{editForm.fromIdx}}" data-k="fromIdx" bindchange="onField">
            <view class="pick-val">第 {{editForm.fromIdx + 1}} 周</view>
          </picker>
          <text class="f-to">至</text>
          <picker class="f-pick" mode="selector" range="{{weekRange}}" value="{{editForm.toIdx}}" data-k="toIdx" bindchange="onField">
            <view class="pick-val">第 {{editForm.toIdx + 1}} 周</view>
          </picker>
        </view>
      </view>
      <view class="f-row">
        <text class="f-label">单双周</text>
        <picker class="f-input2" mode="selector" range="{{parityModes}}" value="{{editForm.parityIdx}}" data-k="parityIdx" bindchange="onField">
          <view class="pick-val">{{parityModes[editForm.parityIdx]}}</view>
        </picker>
      </view>
      <view class="p-btns">
        <view class="btn-danger" wx:if="{{editForm.id}}" bindtap="onDelete">删除</view>
        <view class="btn-ghost" bindtap="closeEditor">取消</view>
        <view class="btn-primary" bindtap="onSave">保存</view>
      </view>
    </view>
  </view>

  <!-- 导入弹窗 -->
  <view class="mask" wx:if="{{importShow}}" bindtap="closeImport">
    <view class="panel" catchtap="noop">
      <view class="p-title">导入课表</view>
      <view class="seg">
        <view class="seg-item {{importTab === 0 ? 'seg-on' : ''}}" data-t="0" bindtap="setImportTab">粘贴文本</view>
        <view class="seg-item {{importTab === 1 ? 'seg-on' : ''}}" data-t="1" bindtap="setImportTab">分享码</view>
        <view class="seg-item {{importTab === 2 ? 'seg-on' : ''}}" data-t="2" bindtap="setImportTab">截图识别</view>
      </view>
      <textarea
        wx:if="{{importTab === 0 || importTab === 1}}"
        class="imp-area"
        value="{{importText}}"
        bindinput="onImportText"
        maxlength="-1"
        placeholder="{{importTab === 0 ? '在电脑上打开课表 Excel，全选复制后粘贴到这里' : '粘贴好友发给你的课表分享码'}}"
      ></textarea>
      <!-- 截图识别 -->
      <view class="ocr-box" wx:if="{{importTab === 2}}">
        <view class="ocr-tip">拍下或截图教务系统课表，自动识别导入，识别后可逐条确认修改。</view>
        <!-- 标准示例卡：点击图片全屏放大；收起后留一个小入口随时再看 -->
        <view class="ocr-sample" wx:if="{{ocrSampleShow && !ocrImagePath}}">
          <view class="ocr-sample-title">📋 标准示例（点图片可放大细看）</view>
          <image class="ocr-sample-img" src="/assets/ocr-sample.jpg" mode="aspectFit" bindtap="previewOcrSample" />
          <view class="ocr-sample-cap">顶部一行是<b>星期</b>（周一~周日），最左一列是<b>节数</b>（第一节、第二节…），每一格就是一门课</view>
          <view class="ocr-sample-hide" catchtap="toggleOcrSample">收起示例</view>
        </view>
        <view class="ocr-sample-mini" wx:if="{{!ocrSampleShow && !ocrImagePath}}" bindtap="toggleOcrSample">📋 展开拍图示例（不知道怎么拍就看这里）</view>
        <view class="ocr-img-area" bindtap="chooseOcrImage">
          <image wx:if="{{ocrImagePath}}" class="ocr-img" src="{{ocrImagePath}}" mode="aspectFit" />
          <view wx:else class="ocr-placeholder">＋ 选择课表截图</view>
        </view>
        <view class="ocr-status" wx:if="{{ocrStatus}}">{{ocrStatus}}</view>
        <view class="p-btns">
          <view class="btn-ghost" bindtap="chooseOcrImage">重新选图</view>
          <view class="btn-primary" bindtap="startOcr">开始识别</view>
        </view>
      </view>
      <view class="help-link" wx:if="{{importTab === 0}}" bindtap="toggleHelp">{{helpShow ? '收起格式说明' : '查看格式说明 / 复制模板'}}</view>
      <view class="help-box" wx:if="{{helpShow && importTab === 0}}">
        <text class="help-line">方式一：每行一门课，用 Tab 或逗号分隔：
课程名 星期 开始节次 节长 周次 教室 老师
例：高等数学 周一 1 2 1-16周 教A-101 张三
周次可写 1-16周、单周、双周、1-16周(双)，留空则默认全部周

方式二：直接粘贴教务系统导出的课表表格
（能自动识别含“周一~周日”表头的网格）</text>
        <view class="mini-btn" bindtap="copyTemplate">复制模板</view>
      </view>
      <view class="p-btns" wx:if="{{importTab === 0 || importTab === 1}}">
        <view class="btn-ghost" bindtap="closeImport">取消</view>
        <view class="btn-primary" bindtap="doImport">解析并导入</view>
      </view>
    </view>
  </view>

  <!-- OCR 识别结果预览 -->
  <view class="mask" wx:if="{{ocrPreviewShow}}" bindtap="closeOcrPreview">
    <view class="panel" catchtap="noop">
      <view class="p-title">识别结果（{{ocrCourses.length}} 门）</view>
      <view class="share-hint">请核对每门课，点条目可修改；确认无误后导入。</view>
      <view class="ocr-preview-list">
        <view class="ocr-item" wx:for="{{ocrCourses}}" wx:key="key" data-idx="{{index}}" bindtap="editOcrCourse">
          <view class="oi-main">
            <text class="oi-name">{{item.name}}</text>
            <text class="oi-sub">周{{item.dayName}} 第{{item.startPeriod}}-{{item.endPeriod}}节 · {{item.weeksText}}</text>
            <text class="oi-sub" wx:if="{{item.room}}">{{item.room}}{{item.teacher ? ' · ' + item.teacher : ''}}</text>
          </view>
          <view class="oi-del" data-idx="{{index}}" catchtap="removeOcrCourse">删除</view>
        </view>
      </view>
      <view class="ocr-warn" wx:if="{{ocrWarnings.length}}">
        <text class="help-line">提示：{{item}}</text>
      </view>
      <view class="p-btns">
        <view class="btn-ghost" bindtap="reOcr">重新识别</view>
        <view class="btn-primary" bindtap="confirmOcrImport">导入这 {{ocrCourses.length}} 门</view>
      </view>
    </view>
  </view>

  <!-- OCR 预览条目编辑 -->
  <view class="mask" wx:if="{{ocrEditShow}}" bindtap="closeOcrEdit">
    <view class="panel" catchtap="noop">
      <view class="p-title">修改课程</view>
      <view class="f-row">
        <text class="f-label">课程名</text>
        <input class="f-input" value="{{ocrEdit.name}}" data-k="name" bindinput="onOcrEditField" />
      </view>
      <view class="f-row">
        <text class="f-label">老师</text>
        <input class="f-input" value="{{ocrEdit.teacher}}" data-k="teacher" bindinput="onOcrEditField" />
      </view>
      <view class="f-row">
        <text class="f-label">教室</text>
        <input class="f-input" value="{{ocrEdit.room}}" data-k="room" bindinput="onOcrEditField" />
      </view>
      <view class="f-row3">
        <picker class="f-pick" mode="selector" range="{{dayOptions}}" value="{{ocrEdit.dayIdx}}" data-k="dayIdx" bindchange="onOcrEditField">
          <view class="pick-val">{{dayOptions[ocrEdit.dayIdx]}}</view>
        </picker>
        <picker class="f-pick" mode="selector" range="{{lenOptions}}" value="{{ocrEdit.lenIdx}}" data-k="lenIdx" bindchange="onOcrEditField">
          <view class="pick-val">上 {{ocrEdit.lenIdx + 1}} 节</view>
        </picker>
      </view>
      <view class="f-row">
        <text class="f-label">周次</text>
        <input class="f-input" value="{{ocrEdit.weeksText}}" data-k="weeksText" placeholder="如 1-16周 或 1-16周(单)" bindinput="onOcrEditField" />
      </view>
      <view class="p-btns">
        <view class="btn-ghost" bindtap="closeOcrEdit">取消</view>
        <view class="btn-primary" bindtap="saveOcrEdit">保存修改</view>
      </view>
    </view>
  </view>

  <!-- 分享弹窗 -->
  <view class="mask" wx:if="{{shareShow}}" bindtap="closeShare">
    <view class="panel" catchtap="noop">
      <view class="p-title">课表分享码</view>
      <view class="share-hint">把下面的码发给同学（微信/QQ 均可），TA 在「导入 → 分享码」里粘贴即可一键导入整张课表。</view>
      <textarea class="share-area" value="{{shareCode}}" maxlength="-1" disabled="{{true}}"></textarea>
      <view class="p-btns">
        <view class="btn-ghost" bindtap="closeShare">关闭</view>
        <view class="btn-primary" bindtap="copyCode">复制分享码</view>
      </view>
    </view>
  </view>

  <!-- 导出图片用的离屏画布 -->
  <canvas
    canvas-id="exportCanvas"
    class="export-canvas"
    style="width: {{exportW}}px; height: {{exportH}}px;"
  ></canvas>
</view>
