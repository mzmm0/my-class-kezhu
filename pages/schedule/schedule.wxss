.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f6fa;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #2f6fed;
  padding: 16rpx 24rpx;
}
.week-nav {
  display: flex;
  align-items: center;
  color: #fff;
}
.wn-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 40rpx;
  color: #fff;
}
.wn-label {
  min-width: 200rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}
.tb-actions {
  display: flex;
}
.tb-actions .tb-btn {
  color: #fff;
  background: rgba(255, 255, 255, 0.18);
  margin-right: 0;
  margin-left: 16rpx;
}

.today-card {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 16rpx 20rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
}
.td-dot {
  width: 14rpx;
  height: 64rpx;
  border-radius: 7rpx;
  background: #8a8f99;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.today-card.next .td-dot {
  background: #2f6fed;
}
.today-card.now .td-dot {
  background: #3fbf7f;
}
.td-main {
  flex: 1;
  min-width: 0;
}
.td-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.today-card.next .td-title {
  color: #2f6fed;
}
.today-card.now .td-title {
  color: #2fa569;
}
.td-sub {
  font-size: 24rpx;
  color: #8a8f99;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.grid-head {
  display: flex;
  background: #2f6fed;
  padding-bottom: 12rpx;
}
.gh-corner {
  width: 90rpx;
}
.gh-day {
  width: 94rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
}
.gh-today {
  color: #ffe27a;
  font-weight: 700;
}

.grid-scroll {
  flex: 1;
  min-height: 0;
}
.grid-body {
  position: relative;
  width: 748rpx;
  margin: 0 auto;
}
.time-cell {
  position: absolute;
  left: 0;
  width: 90rpx;
  height: 112rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.tc-no {
  font-size: 24rpx;
  color: #8a8f99;
}
.tc-time {
  font-size: 18rpx;
  color: #b0b6c0;
}
.cell {
  position: absolute;
  width: 94rpx;
  height: 112rpx;
  box-sizing: border-box;
  border-right: 1rpx solid #e3e6eb;
  border-bottom: 1rpx solid #e3e6eb;
  background: #fff;
}
/* 大节上边界：明显加粗加深 */
.cell-major {
  border-top: 6rpx solid #566070;
}
.time-major {
  border-top: 6rpx solid #566070;
}
/* 最后一节底部：最粗的收尾线 */
.cell-last {
  border-bottom: 10rpx solid #566070;
}
.time-last {
  border-bottom: 10rpx solid #566070;
}
.course-block {
  position: absolute;
  box-sizing: border-box;
  border-radius: 10rpx;
  color: #fff;
  padding: 8rpx;
  overflow: hidden;
}
.cb-name {
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
}
.cb-sub {
  font-size: 18rpx;
  opacity: 0.9;
  line-height: 1.3;
}

.share-hint {
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
