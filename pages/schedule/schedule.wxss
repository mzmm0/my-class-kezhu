.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f6fa;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #2f6fed;
  padding: 16rpx 16rpx;
}
.week-nav {
  display: flex;
  align-items: center;
  color: #fff;
}
.wn-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 36rpx;
  color: #fff;
}
.wn-label {
  min-width: 140rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
}
.tb-actions {
  display: flex;
}
.tb-actions .tb-btn {
  color: #fff;
  background: rgba(255, 255, 255, 0.18);
  margin-right: 0;
  margin-left: 8rpx;
  padding: 10rpx 18rpx;
  font-size: 26rpx;
  white-space: nowrap;
  border-radius: 8rpx;
}

.today-card {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 16rpx 20rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
}
.td-dot {
  width: 14rpx;
  height: 64rpx;
  border-radius: 7rpx;
  background: #8a8f99;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.today-card.next .td-dot {
  background: #2f6fed;
}
.today-card.now .td-dot {
  background: #3fbf7f;
}
.td-main {
  flex: 1;
  min-width: 0;
}
.td-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.today-card.next .td-title {
  color: #2f6fed;
}
.today-card.now .td-title {
  color: #2fa569;
}
.td-sub {
  font-size: 24rpx;
  color: #8a8f99;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.grid-head {
  display: flex;
  background: #2f6fed;
  padding-bottom: 12rpx;
}
.gh-corner {
  width: 90rpx;
}
.gh-day {
  width: 94rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
}
.gh-today {
  color: #ffe27a;
  font-weight: 700;
}

.grid-scroll {
  flex: 1;
  min-height: 0;
}
.grid-body {
  position: relative;
  width: 748rpx;
  margin: 0 auto;
}
.time-cell {
  position: absolute;
  left: 0;
  width: 90rpx;
  height: 112rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.tc-no {
  font-size: 24rpx;
  color: #8a8f99;
}
.tc-time {
  font-size: 18rpx;
  color: #b0b6c0;
}
.cell {
  position: absolute;
  width: 94rpx;
  height: 112rpx;
  box-sizing: border-box;
  border-right: 1rpx solid #e3e6eb;
  border-bottom: 1rpx solid #e3e6eb;
  background: #fff;
}
/* 大节上边界：明显加粗加深 */
.cell-major {
  border-top: 6rpx solid #566070;
}
.time-major {
  border-top: 6rpx solid #566070;
}
/* 最后一节底部：最粗的收尾线 */
.cell-last {
  border-bottom: 10rpx solid #566070;
}
.time-last {
  border-bottom: 10rpx solid #566070;
}
.course-block {
  position: absolute;
  box-sizing: border-box;
  /* 直角填充：与格子边界完全重合（格子为直角，圆角会四角露白） */
  border-radius: 0;
  color: #fff;
  padding: 8rpx 10rpx;
  overflow: hidden;
}
.cb-name {
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
}
.cb-sub {
  font-size: 18rpx;
  opacity: 0.9;
  line-height: 1.3;
}

.share-hint {
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

/* 非本周课程：置灰但保留位置；同样贴满格子，虚线内描边 */
.course-block.cb-dim {
  background: #eef0f4;
  color: #a3a9b4;
  border: 1rpx dashed #cdd2db;
  box-sizing: border-box;
}
.cb-dim .cb-name {
  font-weight: 500;
}
.cb-tag {
  display: inline-block;
  margin-top: 6rpx;
  padding: 0 8rpx;
  font-size: 16rpx;
  line-height: 1.8;
  color: #9aa0aa;
  background: #e1e5eb;
  border-radius: 6rpx;
}

/* 导出的离屏画布：移出可视区，不影响布局 */
.export-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  z-index: -1;
}

/* ---------- 截图识别导入 ---------- */
.ocr-box {
  padding: 8rpx 0;
}
.ocr-tip {
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
/* 标准示例：教务课表长什么样（表头=星期、行头=节数） */
.ocr-sample {
  margin-bottom: 16rpx;
  border: 1rpx solid #e3e6eb;
  border-radius: 12rpx;
  padding: 12rpx;
  background: #fafbfd;
}
.ocr-sample-img {
  width: 100%;
  height: 320rpx;
  display: block;
}
.ocr-sample-cap {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a8f99;
  line-height: 1.5;
}
.ocr-img-area {
  height: 300rpx;
  background: #f5f6fa;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.ocr-img {
  width: 100%;
  height: 100%;
}
.ocr-placeholder {
  color: #b0b6c0;
  font-size: 28rpx;
}
.ocr-status {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #2f6fed;
  text-align: center;
}

/* 识别结果预览 */
.ocr-preview-list {
  max-height: 50vh;
  overflow-y: auto;
  margin-bottom: 8rpx;
}
.ocr-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f6fa;
}
.oi-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.oi-name {
  font-size: 28rpx;
  font-weight: 600;
}
.oi-sub {
  font-size: 22rpx;
  color: #8a8f99;
  margin-top: 6rpx;
}
.oi-del {
  color: #e64340;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
}
.ocr-warn {
  background: #fff7e8;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 12rpx;
}
