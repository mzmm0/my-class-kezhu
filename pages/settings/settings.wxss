.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 24rpx 0 120rpx;
}

.group {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.g-title {
  padding: 24rpx 28rpx 8rpx;
  font-size: 26rpx;
  color: #8a8f99;
}
.row {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid #f7f8fa;
}
.row:last-child {
  border-bottom: none;
}
.r-label {
  flex: 1;
  font-size: 28rpx;
}
.r-val {
  font-size: 28rpx;
  color: #8a8f99;
  margin-right: 12rpx;
}
.r-arrow {
  color: #c3c8cf;
  font-size: 32rpx;
}
.danger {
  color: #e64340;
}
.hint {
  padding: 16rpx 28rpx 24rpx;
  font-size: 22rpx;
  color: #8a8f99;
  line-height: 1.7;
}
/* 续订说明里的小标题（学生向解释文案） */
.hint .hint-b {
  color: #57606e;
  font-weight: 700;
}
/* 剩余额度数字 */
.quota-num {
  font-size: 26rpx;
  font-weight: 700;
}
.quota-ok {
  color: #2e9e5b;
}
.quota-empty {
  color: #d98200;
}
.about {
  padding: 8rpx 28rpx 28rpx;
  font-size: 24rpx;
  color: #8a8f99;
  line-height: 1.8;
  white-space: pre-line;
}

.share-hint {
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

/* 历史快照 */
.snap-empty {
  text-align: center;
  color: #b0b6c0;
  font-size: 26rpx;
  padding: 40rpx 0;
}
.snap-list {
  max-height: 50vh;
  overflow-y: auto;
}
.snap-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f6fa;
}
.snap-item:last-child {
  border-bottom: none;
}
.snap-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.snap-time {
  font-size: 28rpx;
  font-weight: 600;
}
.snap-meta {
  font-size: 22rpx;
  color: #8a8f99;
  margin-top: 6rpx;
}
.snap-restore {
  background: rgba(47, 111, 237, 0.08);
  color: #2f6fed;
  font-size: 26rpx;
  padding: 10rpx 32rpx;
  border-radius: 26rpx;
}
